{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "automerge": true,
  // Copier owns these pins; updates arrive via the template and `copier update`.
  // Order matters: the last matching rule wins, so append any rules that
  // re-enable project-owned files or dependencies after these.
  "packageRules": [
    {
      // Template workflows. Re-enable your own with a later rule matching
      // "github-actions" and "matchFileNames", with "enabled": true.
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      // Template Dockerfile base image.
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["alpine"],
      "enabled": false
    },
    {
      // Template Dockerfile apk packages; project-added packages still update.
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["alpine_*/git"],
      "enabled": false
    }
  ],
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "commitMessageAction": "update",
      "commitMessageTopic": "Nix flake lock"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile[^/]*$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "FROM\\s*.*?alpine[.:]?(?<alpineMajor>\\d+)\\.(?<alpineMinor>\\d+)(?:\\n|.)*",
        "apk\\s+add\\s+(?:\\n|.)*?[^\\\\]\\n",
        "(?<name>[^\\s=~]+)~?=(?<currentValue>[^\\s=]+)"
      ],
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_{{alpineMajor}}_{{alpineMinor}}/{{name}}",
      "versioningTemplate": "loose"
    }
  ]
}
